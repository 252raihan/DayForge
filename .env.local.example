# This file is a template. Copy it to `.env.local` and fill in your values.
# `.env.local` is gitignored and must never be committed.
#
# Find both values in the Supabase dashboard:
#   Project Settings -> API -> Project URL  /  Project API keys (anon, public)

# Your Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase "anon"/publishable API key (safe for the browser).
# Protected by row-level security - never put the service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
